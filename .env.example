# ICA 2026 — environment template.
# Copy to `.env` and fill in locally. `.env` is git-ignored; never commit real
# values. Every variable below is OPTIONAL — the local pipeline
# (`scripts/run_phase1_local.py`) needs none of them, because both Phase-1
# sources are fetched from public, unauthenticated URLs pinned to a commit.

# Override the auto-detected project root (used by notebooks/ when the working
# directory is not the repository root, e.g. on Colab).
ICA_PROJECT_ROOT=

# Hugging Face read token. Only needed if you switch PlantVillage acquisition to
# the authenticated `datasets`/`huggingface_hub` path; the default resolve-URL
# download at revision 9e975998 is public and needs no token.
HF_TOKEN=

# Directory holding kaggle.json, if you use the (discouraged) Kaggle mirrors.
# Kaggle PlantVillage mirrors DROP leaf_id and must not be used as the source of
# truth — see DATASETS.md.
KAGGLE_DIR=

# Roboflow API key, referenced only by the acquisition examples in DATASETS.md.
ROBOFLOW_API_KEY=

checkpoints/
weights/

# --- archives & dataset dumps -------------------------------------------------
# Covers ICA2026_colab.zip (889 MB), data.zip (2.0 GB), the PlantDoc commit
# tarball (938 MB), and phase1_return_package.zip (its contents are tracked
# individually, so the zip itself adds no reproducibility value).
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

